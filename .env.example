# PitStop AI Environment Configuration

# Application
APP_NAME="PitStop AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
FRONTEND_URL="http://localhost:3000"
SECRET_KEY="pitstop-ai-dev-secret-key-change-in-production"

# Database
# Default to SQLite for zero-setup local development:
DATABASE_URL="sqlite:///./pitstop.db"
# Or PostgreSQL for Docker / Production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pitstop_ai"

# AI Configuration (Gemini)
# If GEMINI_API_KEY is not provided, PitStop AI runs in deterministic fallback mode
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# External Integrations
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:8000/api/integrations/calendar/callback"

# Simulation Mode: if True, enables realistic calendar sync simulation and error injection for demonstration
SIMULATE_CALENDAR=True

# Real Email Delivery via SMTP (Optional: for sending real emails to Gmail inboxes)
# To send real emails from Gmail, enter your Gmail and 16-character Google App Password:
# (Generate at https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="PitStop AI Workshop"

